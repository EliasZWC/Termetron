#!/usr/bin/env sh
# Termetron —— 以 Linux 命令方式启动
#
# 用法：
#   ./termetron                 # 自动检测 Tailscale IP 并监听
#   ./termetron --port 9000
#   ./termetron --local-only    # 只监听 127.0.0.1
#   ./termetron --host 0.0.0.0
#
# 安装成全局命令（**只推荐软链接**）：
#   sudo ln -s "$PWD/termetron" /usr/local/bin/termetron
#
# 也可以装到家目录（不需要 sudo）：
#   ln -s "$PWD/termetron" ~/termetron
#
# ⚠️ 不要用 cp 复制！复制出来的是一份**静态快照**：
#    项目里改了代码，全局命令还是旧的，表现为「明明改好了却没生效」
#    （实测踩过：二维码功能加了，执行 termetron remote 仍是旧输出）。
#    软链接始终指向项目里的那一份，永远不会过期。
#
# ⚠️ 为什么用 sh 包装而不是直接跑 python：
#    · 手机端要填的 IP 需要打印出来，包装脚本能顺手做这件事
#    · 需要处理「在 WSL 里但 Tailscale 在 host」这种常见错配
#    · 用户希望像普通命令一样用（termetron 而不是 python3 termetron.py）

set -e

# 解析脚本真实路径（支持通过软链接调用）
SELF="$0"
while [ -L "$SELF" ]; do
    LINK=$(readlink "$SELF")
    case "$LINK" in
        /*) SELF="$LINK" ;;
        *) SELF="$(dirname "$SELF")/$LINK" ;;
    esac
done
DIR=$(cd "$(dirname "$SELF")" && pwd)

# 自检：脚本必须和 quant_terminal.py 在同一个目录。
# 不满足就说明这是一份**孤立的拷贝**（比如从项目里 cp 出来的），
# 它不会跟着项目更新 —— 表现为「代码明明改了却看不到变化」。
# 宁可明确报错，也不要让人去猜为什么改动没生效。
if [ ! -f "$DIR/quant_terminal.py" ]; then
    echo "[termetron] error: quant_terminal.py not found next to this launcher." >&2
    echo "[termetron]   This looks like a copied file, not a symlink:  $SELF" >&2
    echo "[termetron]   A copy never picks up project updates." >&2
    echo "[termetron]   Replace it with a symlink instead:" >&2
    echo "[termetron]     ln -sf /path/to/Termetron/termetron $SELF" >&2
    exit 1
fi

# 选 Python：优先 python3（Linux/WSL），回退 python（部分发行版/Windows Git Bash）
PY=""
for candidate in python3 python; do
    if command -v "$candidate" >/dev/null 2>&1; then
        # 必须 3.8+（用了 `str | None` 的写法需要 3.10+，这里只挡掉 python2）
        if "$candidate" -c 'import sys; sys.exit(0 if sys.version_info[0] == 3 else 1)' 2>/dev/null; then
            PY="$candidate"
            break
        fi
    fi
done

if [ -z "$PY" ]; then
    echo "[termetron] error: Python 3 not found" >&2
    echo "[termetron]   Debian/Ubuntu: sudo apt install python3" >&2
    echo "[termetron]   Arch:          sudo pacman -S python" >&2
    exit 1
fi

# 提前检查 Tailscale，给出可操作的提示（服务端自己也会检测，这里只是提前告知）
if [ -z "${TERMETRON_TS_IP:-}" ] && ! command -v tailscale >/dev/null 2>&1; then
    echo "[termetron] note: tailscale command not found." >&2
    echo "[termetron]   If Tailscale runs on Windows while this runs in WSL," >&2
    echo "[termetron]   your phone cannot reach WSL directly — install Tailscale inside WSL too." >&2
fi

cd "$DIR"
# ⚠️ 直接调 quant_terminal.py，不经过 termetron.py：
#    termetron.py 是**桌面启动器**（默认端口 8900、自动开浏览器、
#    还会把 --port 吃掉再转发），用在命令行场景会得到意外行为。
#    quant_terminal.py 才是真正的服务端（默认端口 8899、监听 Tailscale IP）。
# ── 子命令分流 ─────────────────────────────────────────────────────────
# 带隧道管理子命令时交给 termetron_cli.py，其余（无参数 / --port /
# --local-only / --remote ...）仍启动服务端。
# ⚠️ 必须在这里分流而不是让 quant_terminal.py 加子命令：那个文件同时是
#    服务端入口，加子命令会把它自己的 argparse 搞复杂，且桌面快捷方式的
#    "--port" 语义会和服务的 "--port" 撞车。
#
# 长期挂机的正确用法（隧道挂在服务进程下，随服务存活）：
#     ./termetron --remote
# 单纯的 ./termetron 只开服务、不开隧道 —— 手机连不上。
case "${1:-}" in
    new|list|show|use|delete|clear|remote)
        exec "$PY" termetron_cli.py "$@"
        ;;
    ls)
        shift
        exec "$PY" termetron_cli.py list "$@"
        ;;
    rm)
        shift
        exec "$PY" termetron_cli.py delete "$@"
        ;;
    reset)
        shift
        exec "$PY" termetron_cli.py clear "$@"
        ;;
esac

exec "$PY" quant_terminal.py "$@"
