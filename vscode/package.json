{
  "name": "termetron",
  "displayName": "Termetron",
  "description": "Geometric metron terminal — multi-session web terminal with live progress bars and mobile remote access. Embedded in a VS Code panel as a real browser view (iframe + portMapping); optional system-browser fallback.",
  "version": "0.5.9",
  "publisher": "EliasZhang",
  "icon": "icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "terminal",
    "remote",
    "session",
    "tunnel",
    "mobile"
  ],
  "main": "./out/extension.js",
  "api": "0.0.1",
  "contributes": {
    "configuration": {
      "title": "Termetron",
      "properties": {
        "termetron.serverPort": {
          "type": "number",
          "default": 8900,
          "description": "Preferred local port: reuse an existing Termetron server on this port if running, otherwise start the extension server here."
        }
      }
    },
    "commands": [
      {
        "command": "termetron.open",
        "title": "Termetron: Open Terminal",
        "category": "Termetron"
      },
      {
        "command": "termetron.openBrowser",
        "title": "Termetron: Open in System Browser",
        "category": "Termetron"
      },
      {
        "command": "termetron.connect",
        "title": "Termetron: Connect to Server...",
        "category": "Termetron"
      },
      {
        "command": "termetron.restart",
        "title": "Termetron: Restart Server",
        "category": "Termetron"
      },
      {
        "command": "termetron.stop",
        "title": "Termetron: Stop Server",
        "category": "Termetron"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && npm run copy-server",
    "copy-server": "node -e \"const fs=require('fs'),p='out/server';fs.mkdirSync(p,{recursive:true});fs.copyFileSync('../quant_terminal.py',p+'/quant_terminal.py')\"",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^20.0.0",
    "@vscode/vsce": "^2.26.0",
    "typescript": "^5.5.0"
  }
}
